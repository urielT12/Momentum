# Copy to .env.local and fill in.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Free key from https://aistudio.google.com/apikey (meal photo scanning, server-side only).
# Leave empty to disable photo scanning; manual meal entry still works.
GEMINI_API_KEY=
# Optional override; defaults to gemini-flash-latest
# GEMINI_MODEL=gemini-flash-latest
